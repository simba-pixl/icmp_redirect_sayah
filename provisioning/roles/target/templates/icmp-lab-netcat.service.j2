[Unit]
Description=ICMP redirect lab - Task 2 netcat-like listener
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/sbin/nc-logger.py {{ nc_port }} /var/log/icmp-redirect-lab/received.log
Restart=always
User=root
Group=root
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
