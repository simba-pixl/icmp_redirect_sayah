#!/bin/bash
set -eu

TARGET="192.168.60.5"
MALICIOUS_GW="10.9.0.111"

GW_IN_USE=$(ip route get "${TARGET}" 2>/dev/null | grep -oP 'via \\K[0-9.]+' || true)

if [ "${GW_IN_USE}" = "${MALICIOUS_GW}" ]; then
    echo "Redirect confirmed: traffic to ${TARGET} now goes via ${GW_IN_USE}."
    echo "FLAG: {{ flag_task1 }}"
else
    echo "No redirect detected yet (current gateway for ${TARGET}: ${GW_IN_USE:-none})."
    echo "Generate traffic to ${TARGET}, send the spoofed redirect, then retry."
    echo "You can inspect the route cache with: ip route show cache"
fi
