#!/bin/bash
set -eu

LOG="/var/log/icmp-redirect-lab/received.log"
SECRET="{{ secret_word }}"
{% raw -%}
REPLACEMENT=$(printf 'A%.0s' $(seq 1 ${#SECRET}))

if [ ! -f "${LOG}" ]; then
    echo "No traffic received yet on this service."
    exit 0
fi

if grep -qF -- "${SECRET}" "${LOG}"; then
    echo "The raw secret word still arrived unmodified - the MITM replacement failed."
elif grep -qF -- "${REPLACEMENT}" "${LOG}"; then
    echo "Redaction confirmed: the secret word arrived replaced by ${#SECRET} 'A' characters."
{%- endraw %}
    echo "FLAG: {{ flag_task2 }}"
{% raw -%}
else
    echo "No matching transformed traffic found yet."
fi
{%- endraw %}
